#!/usr/bin/env bash
# commit-msg hook — validate commit message against COMMIT_FORMAT.md (sprag).
#
# Rules (see COMMIT_FORMAT.md):
#   1. Subject (line 1): `<type>(<scope>)?: <subject>` shape; type in
#      {feat, fix, refactor, test, docs, build, chore}; max 72 bytes;
#      no trailing period.
#   2. Line 2: blank (separator).
#   3. Body lines: max 72 bytes each; no multi-line bullet wrap
#      (one bullet = one line). Body is `- ` bullets ONLY — no prose
#      lead paragraph, no blank line between bullets (contiguous) —
#      and at most 3 bullets.
#   4. Style: English only (ASCII U+0020-U+007E plus the small
#      typographic whitelist §, –, —, •, …, →); no `Co-Authored-By`;
#      no `Generated with Claude Code`; no emoji (Unicode pictograph
#      ranges U+1F300-U+1FAFF and U+1F1E6-U+1F1FF).
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
set -euo pipefail

msg_file="$1"

# Skip merge commits — git writes their subject and user did not author it.
first_line=$(head -n 1 "$msg_file")
if [[ "$first_line" =~ ^Merge ]]; then
    exit 0
fi

# Strip leading '#'-comment lines (git appends instructions during interactive
# commit; they are stripped before commit lands, so the hook should not see
# them as content).
#
# ⚠⚠⚠⚠⚠ READ IN A LOOP RATHER THAN WITH `mapfile`, WHICH IS A BASH 4 BUILTIN AND
# THIS HOOK RUNS ON MACHINES THAT SHIP BASH 3.2. macOS is the one that matters and
# it is not going to change: Apple froze bash at 3.2 over its licence, so
# `#!/usr/bin/env bash` there resolves to a shell without this builtin.
#
# ⚠⚠⚠⚠ WHAT THAT COST, and it is worse than a red test: `set -e` made line 32 the
# END of this hook, so on macOS **every rule below was unreachable** — the emoji
# rule, the English-only rule, the bullet rules. A Mac committed whatever it liked
# and the hook reported a missing builtin. Four gates in `sprag-gate` said so on
# every CI run from 2026-08-14, and nobody read them (register items 460, 151).
#
# ⚠⚠ `IFS=` and `-r` are what make the loop equivalent: without them `read` would
# strip leading and trailing whitespace and eat backslashes, and this hook measures
# lines BY BYTE. `grep` always ends its output with a newline, so no line is lost
# to the loop's final read.
lines=()
while IFS= read -r line; do
    lines+=("$line")
done < <(grep -v '^#' "$msg_file")

errors=()

# Last non-empty line index — trim trailing blank lines.
last_nonempty=-1
for ((i=${#lines[@]}-1; i>=0; i--)); do
    if [[ -n "${lines[i]}" ]]; then
        last_nonempty=$i
        break
    fi
done

if [[ "$last_nonempty" -lt 0 ]]; then
    echo "commit-msg: empty message" >&2
    exit 1
fi

# --- Rule 1: Subject line (line 1) ---
subject="${lines[0]:-}"
subject_bytes=$(printf '%s' "$subject" | wc -c)

if ! [[ "$subject" =~ ^(feat|fix|refactor|test|docs|build|chore)(\([a-zA-Z0-9_/-]+\))?:\ .+$ ]]; then
    errors+=("Line 1: subject must match '<type>(<scope>)?: <subject>' with type in {feat,fix,refactor,test,docs,build,chore}")
fi

if [[ "$subject_bytes" -gt 72 ]]; then
    errors+=("Line 1: $subject_bytes bytes (max 72)")
fi

if [[ "$subject" =~ \.$ ]]; then
    errors+=("Line 1: subject must not end with a period")
fi

# --- Rule 2: Line 2 must be blank (when body is present) ---
if [[ "$last_nonempty" -ge 1 && -n "${lines[1]:-}" ]]; then
    errors+=("Line 2: must be blank (separator between subject and body)")
fi

# --- Rule 3: Body lines (lines 3+) ---
# Body is `- ` bullets only — no prose lead paragraph — at most 3.
prev_was_bullet=0
bullet_count=0
for ((i=2; i<=last_nonempty; i++)); do
    line="${lines[i]:-}"
    line_num=$((i+1))

    # No blank / whitespace-only line inside the body — the bullets
    # must be contiguous (a blank "enter" between bullets is rejected).
    if [[ "$line" =~ ^[[:space:]]*$ ]]; then
        errors+=("Line $line_num: blank line inside body — bullets must be contiguous, no blank separators (COMMIT_FORMAT.md §3)")
        prev_was_bullet=0
        continue
    fi

    line_bytes=$(printf '%s' "$line" | wc -c)

    # Length check
    if [[ "$line_bytes" -gt 72 ]]; then
        errors+=("Line $line_num: $line_bytes bytes (max 72)")
    fi

    # Bullet-only: every non-empty body line must start with '- '.
    if [[ "$line" =~ ^-\  ]]; then
        prev_was_bullet=1
        bullet_count=$((bullet_count+1))
    else
        if [[ "$prev_was_bullet" -eq 1 && "$line" =~ ^[[:space:]]+[^[:space:]] ]]; then
            errors+=("Line $line_num: indented continuation of previous bullet — one bullet = one line")
        else
            errors+=("Line $line_num: body must be '- ' bullets only, no prose (COMMIT_FORMAT.md §3)")
        fi
        prev_was_bullet=0
    fi
done

# At most 3 bullets — condense to the key changes (COMMIT_FORMAT.md §3).
if [[ "$bullet_count" -gt 3 ]]; then
    errors+=("Body has $bullet_count bullets (max 3) — condense to 1-3 key changes (COMMIT_FORMAT.md §3)")
fi

# --- Rule 4: Forbidden style markers (whole message) ---
if grep -q -E 'Co-Authored-By|Co-authored-by' "$msg_file"; then
    errors+=("Forbidden tag: 'Co-Authored-By' (COMMIT_FORMAT.md §4)")
fi
if grep -q -E 'Generated with Claude Code|Generated by Claude Code' "$msg_file"; then
    errors+=("Forbidden tag: 'Generated with Claude Code' (COMMIT_FORMAT.md §4)")
fi

# ⚠⚠⚠⚠ THE TWO RULES BELOW HAVE EXACTLY ONE IMPLEMENTATION — `grep -P` — AND ITS ABSENCE WAS
# SILENT. Register item 213, found by that item's audit one file over. `grep -qP … 2>/dev/null`
# on a grep without PCRE (BSD grep, the macOS default; busybox) exits 2 with its complaint in
# `/dev/null`; the `if` then reads FALSE and BOTH gates pass. Measured on this tree 2026-08-17
# with a PCRE-less `grep` first on PATH: a message carrying an emoji AND Hangul was accepted at
# exit 0, where the same message is refused at exit 1 here.
#
# So availability is asked ONCE, out loud, and REFUSES rather than skips — this repo's settled
# answer for a tool it needs (`mnemosyne-cli` in `pre-commit`; xvfb and the lavapipe ICD in
# `pre-push`): a gate that steps aside on the machine lacking its tools is absent exactly where
# nobody notices. The deliberate bypass is `--no-verify`, which is loud.
#
# The probe matches a literal on one line of input, so it separates "no PCRE" (exit 2, an error
# on stderr) from "PCRE present, no match" (exit 1) — an empty pattern against empty input
# cannot, since it finds no line to match and answers 1 either way.
if ! printf 'x\n' | grep -qP 'x' 2>/dev/null; then
    echo "commit-msg: this grep has no -P (PCRE), and the emoji and English-only rules below" >&2
    echo "commit-msg: have no other implementation — they would pass on ANY message." >&2
    echo "commit-msg: install GNU grep and put it first on PATH (macOS: brew install grep, then" >&2
    echo "commit-msg: PATH=\"\$(brew --prefix)/opt/grep/libexec/gnubin:\$PATH\")." >&2
    exit 1
fi

# Emoji detection — Unicode pictograph / regional-indicator ranges.
# ⚠ stderr is NOT discarded: the probe above settled that `-P` works, so anything this grep says
# on stderr from here on is a real failure and belongs in front of the person committing.
if grep -qP '[\x{1F300}-\x{1FAFF}\x{1F1E6}-\x{1F1FF}]' "$msg_file"; then
    errors+=("Emoji detected (COMMIT_FORMAT.md §4: no emojis)")
fi

# English-only check — whitelist ASCII printable (U+0020-U+007E) + tab
# (U+0009) + LF (U+000A) + CR (U+000D) plus the small typographic
# symbol set (§ U+00A7, – U+2013, — U+2014, • U+2022, … U+2026,
# → U+2192). Anything else (Hangul, CJK, Cyrillic, etc.) is rejected.
if non_english_lines=$(grep -nP '[^\x{0009}\x{000A}\x{000D}\x{0020}-\x{007E}\x{00A7}\x{2013}\x{2014}\x{2022}\x{2026}\x{2192}]' "$msg_file"); then
    if [[ -n "$non_english_lines" ]]; then
        errors+=("Non-English / non-whitelisted character (COMMIT_FORMAT.md §4: English only)")
        while IFS= read -r offender; do
            errors+=("  $offender")
        done <<< "$(printf '%s\n' "$non_english_lines" | head -n 5)"
    fi
fi

if [[ "${#errors[@]}" -gt 0 ]]; then
    echo "commit-msg: COMMIT_FORMAT.md violations:" >&2
    for err in "${errors[@]}"; do
        echo "  - $err" >&2
    done
    echo "" >&2
    echo "See COMMIT_FORMAT.md for the full rule set." >&2
    exit 1
fi

exit 0
