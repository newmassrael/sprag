#!/usr/bin/env bash
# Mnemosyne SSOT gate + rustfmt + clippy — runs on every `git commit`.
#
# Blocks the commit if any gate trips:
#
#   1. `mnemosyne-cli validate-workspace`
#      - new T1 cross-ref orphans (not registered in [[orphan_ledger]])
#      - resolved ledger entries (entry stale, drift catch)
#      - atomic-store consistency (entries / sections; store-direct)
#
#   2. `rustfmt --check` on the STAGED *.rs files (edition 2024)
#      - checks exactly what is being committed, and nothing else: no
#        untouched file can fail a commit that did not touch it.
#      - ⚠ THE REASON THIS ONCE GAVE WAS FALSE, and it is corrected rather
#        than deleted because a reader acted on it. It said `cargo fmt --all`
#        "walks path-deps INTO pinion". Measured 2026-08-17 with
#        `cargo fmt -v --all`: 60 targets, every one under
#        `/home/coin/sprag/crates/`, not one pinion path. `--all` means
#        WORKSPACE MEMBERS, and pinion is not one — it has been a pinned git
#        rev since R54 (see Cargo.toml: "sprag NO LONGER reads the sibling
#        ../pinion working tree"), so it lives in cargo's checkout cache and
#        is not reachable from here at all.
#
#   3. `cargo clippy --workspace --all-targets -- -D warnings`
#      - only runs when a Cargo workspace exists (Cargo.toml present) AND
#        staged files include `*.rs`. docs/atomic-only commits stay cheap.
#      - `-D warnings` is load-bearing: without it the line printed findings
#        and exited 0, and three lints rode through on that.
#
#   4. the rustdoc gate (`.githooks/doc-gate.sh`)
#      - same condition as clippy. Catches a broken intra-doc link at the
#        commit that writes it, which is the only cheap place to catch one:
#        rustdoc is not run by any build, so before this gate existed the
#        breakage accumulated silently (five links, across three crates).
#
# Install via:
#   git config core.hooksPath .githooks
# (one-time per clone; `.githooks/` is tracked, `.git/hooks/` is not)
set -euo pipefail

if ! command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-commit: mnemosyne-cli not on PATH — install mnemosyne-cli first" >&2
    exit 1
fi

# Discover repo root so `mnemosyne.toml` discovery walks upward correctly
# regardless of where `git commit` was invoked.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/doc-gate.sh"

mnemosyne-cli validate-workspace

# The CITATION gate, and a separate command on purpose: `validate-workspace`
# runs only the Round 783 *coverage* check (is every `.rs` scanned or declared),
# never the citations themselves. Measured, not assumed — a planted `§9.99` in a
# module header left `validate-workspace` at exit 0. So `severity_missing =
# "reject"` in mnemosyne.toml enforced NOTHING until this line existed, which is
# how the rustdoc gate's five dead links accumulated before it was wired in too.
#
# Unconditional, unlike clippy below: a citation breaks from EITHER side — a
# comment naming a section that is gone, or a store edit that removes one — and
# the second touches no `*.rs` at all. It costs ~16ms.
#
# ⚠⚠⚠⚠ AND ITS REPORT IS NO LONGER THROWN AWAY — register item 213, whose whole point is that a
# check nothing reads accumulates silently. Measured on this tree, 2026-08-17:
#
#   violations: total=52 ... citation_unbound=47 ... impl_missing=5   →   exit 0
#
# The code is RIGHT — `severity_missing = "reject"` covers `missing` / `section_missing`, both at
# zero — but fifty-two findings were being printed into `/dev/null`, so the one number that would
# show this drifting was visible to nobody. That is the clippy defect one command over: the gate
# said something and the hook discarded it.
#
# ⚠⚠ THE EXIT CODE STILL DECIDES. This prints the summary line and blocks on nothing new, because
# which classes should REJECT is a store-configuration decision and not a hook's to take. What
# changes is that the number now appears at the commit that moves it.
echo "pre-commit: mnemosyne-cli validate-code-refs ..." >&2
if ! refs_report="$(mnemosyne-cli validate-code-refs 2>&1)"; then
    printf 'pre-commit: validate-code-refs REFUSED:\n%s\n' "$refs_report" >&2
    exit 1
fi
printf '%s\n' "$refs_report" | grep -E '^violations:' >&2 || true

# rustfmt gate — only the STAGED *.rs files, so a commit is judged on what it
# actually carries. Blocks on any unformatted staged file. (The pinion claim
# this used to give as its reason was measured false; see the header.)
staged_rs="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.rs$' || true)"
if [ -n "$staged_rs" ]; then
    echo "pre-commit: rustfmt --check (staged *.rs) ..." >&2
    # shellcheck disable=SC2086  # intentional word-split of the file list
    rustfmt --edition 2024 --check $staged_rs
fi

# ⚠⚠⚠ `-D warnings`, AND ITS ABSENCE WAS MEASURED RATHER THAN SUSPECTED. Without it this line
# PRINTED lint findings and exited 0, so a warning was a thing the gate said and then let through —
# and three of them (two `type_complexity`, one `manual_contains`, all in `live_agent.rs`) rode
# through several commits until somebody ran clippy by hand with the flag. That is the same failure
# the doc gate below was wired in to stop: a check nothing enforces accumulates silently, and the
# only cheap place to catch a lint is the commit that writes it.
#
# ⚠ The toolchain is PINNED (`rust-toolchain.toml`), so this cannot go red under somebody's newer
# clippy without the pin moving first — which is a decision somebody takes rather than a drift.
if [ -f Cargo.toml ] && git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$'; then
    echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings ..." >&2
    cargo clippy --workspace --all-targets -- -D warnings

    doc_gate
fi

# ⚠⚠ A WORKFLOW FILE IS THE ONE THING CI CANNOT GATE.
#
# Every other check here has a second chance on the runner. This one does not: a workflow whose
# expression is invalid does not fail a step, it never STARTS — no jobs, no log, and a run that
# ends in the same second it began. R343 shipped exactly that (`runner.temp` in a job-level `env:`,
# where the `runner` context does not exist) and burned a push finding out.
#
# `yaml.safe_load` cannot see it: the file PARSES. `actionlint` knows the context-availability
# table, and it was already installed on this box while nothing ran it. Measured on the broken
# file: six errors naming the context and the line. Measured on the fixed one: exit 0.
#
# Skipped with a WORD rather than silently when the tool is absent, because a gate that vanishes
# quietly is one people stop expecting.
staged_workflows="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.github/workflows/.*\.ya?ml$' || true)"
if [ -n "$staged_workflows" ]; then
    if command -v actionlint >/dev/null 2>&1; then
        echo "pre-commit: actionlint (staged workflows) ..." >&2
        # shellcheck disable=SC2086  # intentional word-split of the file list
        actionlint $staged_workflows
    else
        echo "pre-commit: actionlint NOT INSTALLED — a workflow change is going out UNCHECKED." >&2
        echo "pre-commit: install it (https://github.com/rhysd/actionlint) before touching CI again." >&2
    fi
fi
