#!/usr/bin/env bash
# Mnemosyne SSOT gate + rustfmt + clippy — runs on every `git commit`.
#
# Blocks the commit if any gate trips:
#
#   1. `mnemosyne-cli validate-workspace`
#      - new T1 cross-ref orphans (not registered in [[orphan_ledger]])
#      - resolved ledger entries (entry stale, drift catch)
#      - atomic-store consistency (entries / sections; store-direct)
#
#   2. `rustfmt --check` on the STAGED CONTENT of the staged *.rs files
#      (edition 2024, via `.githooks/content-gate.sh`)
#      - checks exactly what is being committed, and nothing else: no
#        untouched file can fail a commit that did not touch it.
#      - ⚠⚠⚠⚠ THAT SENTENCE WAS FALSE UNTIL 2026-08-17 and is kept only
#        because it is now TRUE. This line used to take the staged NAMES and
#        hand rustfmt the WORKING-TREE BYTES, which is a different thing: a
#        commit carrying unformatted Rust passed if the file was tidied after
#        staging, and a commit carrying formatted Rust was refused for an edit
#        it was not carrying. Both measured by driving the hook (item 404).
#      - ⚠ THE OTHER REASON THIS ONCE GAVE WAS ALSO FALSE, and it is corrected
#        rather than deleted because a reader acted on it. It said `cargo fmt
#        --all` "walks path-deps INTO pinion". Measured 2026-08-17 with
#        `cargo fmt -v --all`: 60 targets, every one under
#        this repository's own `crates/`, not one pinion path. `--all` means
#        WORKSPACE MEMBERS, and pinion is not one — it has been a pinned git
#        rev since R54 (see Cargo.toml: "sprag NO LONGER reads the sibling
#        ../pinion working tree"), so it lives in cargo's checkout cache and
#        is not reachable from here at all.
#
#   3. `cargo clippy --workspace --all-targets -- -D warnings`
#      - only runs when a Cargo workspace exists (Cargo.toml present) AND
#        staged files include `*.rs`. docs/atomic-only commits stay cheap.
#      - `-D warnings` is load-bearing: without it the line printed findings
#        and exited 0, and three lints rode through on that.
#
#   4. the rustdoc gate (`.githooks/doc-gate.sh`)
#      - same condition as clippy. Catches a broken intra-doc link at the
#        commit that writes it, which is the only cheap place to catch one:
#        rustdoc is not run by any build, so before this gate existed the
#        breakage accumulated silently (five links, across three crates).
#
# Install via:
#   git config core.hooksPath .githooks
# (one-time per clone; `.githooks/` is tracked, `.git/hooks/` is not)
set -euo pipefail

if ! command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-commit: mnemosyne-cli not on PATH — install mnemosyne-cli first" >&2
    exit 1
fi

# Discover repo root so `mnemosyne.toml` discovery walks upward correctly
# regardless of where `git commit` was invoked.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/doc-gate.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/content-gate.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/ident-gate.sh"

# The identity this commit would carry, FIRST and ahead of anything that costs.
# It is also the one refusal here a revert does not undo: the remote is public
# and a push does not un-publish. ⚠ Sharper in THIS tree than elsewhere,
# because two writers commit into it — the debt loop runs unattended, and an
# identity gate is the only thing that separates its commits from a stray
# environment's without a person reading every one. See ident-gate.sh.
ident_gate_pending "pre-commit" || exit 1

mnemosyne-cli validate-workspace

# The CITATION gate, and a separate command on purpose: `validate-workspace`
# runs only the Round 783 *coverage* check (is every `.rs` scanned or declared),
# never the citations themselves. Measured, not assumed — a planted `§9.99` in a
# module header left `validate-workspace` at exit 0. So `severity_missing =
# "reject"` in mnemosyne.toml enforced NOTHING until this line existed, which is
# how the rustdoc gate's five dead links accumulated before it was wired in too.
#
# Unconditional, unlike clippy below: a citation breaks from EITHER side — a
# comment naming a section that is gone, or a store edit that removes one — and
# the second touches no `*.rs` at all. It costs ~16ms.
#
# ⚠⚠⚠⚠ AND ITS REPORT IS NO LONGER THROWN AWAY — register item 213, whose whole point is that a
# check nothing reads accumulates silently. Measured on this tree, 2026-08-17:
#
#   violations: total=52 ... citation_unbound=47 ... impl_missing=5   →   exit 0
#
# The code is RIGHT — `severity_missing = "reject"` covers `missing` / `section_missing`, both at
# zero — but fifty-two findings were being printed into `/dev/null`, so the one number that would
# show this drifting was visible to nobody. That is the clippy defect one command over: the gate
# said something and the hook discarded it.
#
# ⚠⚠ THE EXIT CODE STILL DECIDES. This prints the summary line and blocks on nothing new, because
# which classes should REJECT is a store-configuration decision and not a hook's to take. What
# changes is that the number now appears at the commit that moves it.
echo "pre-commit: mnemosyne-cli validate-code-refs ..." >&2
if ! refs_report="$(mnemosyne-cli validate-code-refs 2>&1)"; then
    printf 'pre-commit: validate-code-refs REFUSED:\n%s\n' "$refs_report" >&2
    exit 1
fi
# ⚠⚠⚠⚠ AND THE FILTER CANNOT SWALLOW THE MISS. Showing only lines that begin `violations:` pins
# item 213's fix to a WORD, in a tool this repository pins no version of: rename that summary and
# the filter matches nothing, `|| true` hides that it matched nothing, and fifty-two findings are
# back in /dev/null with nobody the wiser. A summary line this hook does not recognise is still the
# report, so it is shown whole rather than dropped.
if ! printf '%s\n' "$refs_report" | grep -E '^violations:' >&2; then
    printf 'pre-commit: validate-code-refs printed no "violations:" summary; its report in full:\n%s\n' \
        "$refs_report" >&2
fi

# rustfmt gate — the STAGED CONTENT of the staged *.rs files, so a commit is
# judged on what it actually carries. See `.githooks/content-gate.sh` for why the
# content is materialised rather than read off disk, and for the measurement
# that showed reading off disk to be wrong in both directions.
# ⚠⚠⚠⚠ THE INDEX IS READ ONCE, AND THE READ IS CHECKED — `|| true` ABSORBS THE TOOL FAILING, NOT
# JUST THE PATTERN MISSING.
#
# This used to be two separate `git diff --cached … | grep -E … || true` pipelines. The `|| true` is
# needed, because grep answers 1 when nothing matches — but it swallows GIT failing just as happily,
# and an empty list is indistinguishable from "this commit carries no Rust". So an index the hook
# could not read passed as a commit with nothing to check, and since every gate below is keyed off
# these variables, ONE unreadable index waived rustfmt, clippy and the rustdoc gate together.
# Measured by driving the hook against a git that fails `diff --cached` (item 404).
if ! staged="$(git diff --cached --name-only --diff-filter=ACMR)"; then
    echo "pre-commit: could not read the index — a gate cannot judge what it cannot read" >&2
    exit 1
fi
staged_rs="$(printf '%s\n' "$staged" | grep -E '\.rs$' || true)"
staged_workflows="$(printf '%s\n' "$staged" | grep -E '^\.github/workflows/.*\.ya?ml$' || true)"
if [ -n "$staged_rs" ]; then
    # shellcheck disable=SC2086  # intentional word-split of the file list
    if ! fmt_gate "pre-commit" "" $staged_rs; then
        echo "pre-commit: the STAGED content is unformatted — format it and stage the result" >&2
        exit 1
    fi
fi

# ⚠⚠⚠ `-D warnings`, AND ITS ABSENCE WAS MEASURED RATHER THAN SUSPECTED. Without it this line
# PRINTED lint findings and exited 0, so a warning was a thing the gate said and then let through —
# and three of them (two `type_complexity`, one `manual_contains`, all in `live_agent.rs`) rode
# through several commits until somebody ran clippy by hand with the flag. That is the same failure
# the doc gate below was wired in to stop: a check nothing enforces accumulates silently, and the
# only cheap place to catch a lint is the commit that writes it.
#
# ⚠ The toolchain is PINNED (`rust-toolchain.toml`), so this cannot go red under somebody's newer
# clippy without the pin moving first — which is a decision somebody takes rather than a drift.
# ⚠⚠⚠⚠ THE CONDITION REUSES `$staged_rs` RATHER THAN ASKING GIT AGAIN, AND THAT IS A FIX, NOT TIDYING.
# It used to re-run `git diff --cached --name-only … | grep -qE '\.rs$'`. Under `set -o pipefail`
# that pipeline can FAIL FROM SUCCEEDING: `grep -q` exits the instant it matches — on the FIRST line
# — so once the staged list is longer than a pipe buffer (~64K), git is still writing when the
# reader goes away, takes EPIPE, and dies. `pipefail` makes the pipeline nonzero, the `if` reads
# FALSE, and clippy and the rustdoc gate are SKIPPED IN SILENCE.
# ⚠⚠⚠ MEASURED BOTH WAYS: a handful of staged files does not reproduce it (git finishes writing
# first), and three thousand does — so the commits that escaped the lint were the LARGEST ones.
# `$staged_rs` is built with `grep -E` and no `-q`, which reads its input to the end.
if [ -f Cargo.toml ] && [ -n "$staged_rs" ]; then
    # ⚠ ROUTED THROUGH THE BUILD-MACHINE WRAPPER WHEN ONE IS CONFIGURED (`$BX`),
    # because these two are the heaviest thing this hook does to the machine it
    # runs on. Measured 2026-08-19 on the 31GB workstation: the doc gate spawned
    # five concurrent rustdocs and ONE of them reached 6.5GB RSS, which pushed
    # 13GB into swap and took the box to load 29 while 82% of its CPU sat idle —
    # all of that load was processes blocked on the paging disk, none of it
    # compute. The note below already records this gate at 250s; that is its
    # cost in TIME, and this is its cost in MEMORY.
    #
    # THE TWO TRAVEL TOGETHER so the tree is synced once rather than twice, and
    # `&&` keeps clippy's fail-fast: a clippy failure never reaches the doc gate.
    # (They do not share a warm build the way some workspaces do — `doc_gate`
    # sets its own `CARGO_TARGET_DIR`, which is exactly why it costs 250s — so
    # what is saved here is the transfer, not a rebuild.)
    #
    # `$BX` IS AN OPT-IN AND ITS ABSENCE IS THE OLD BEHAVIOUR. No host, path or
    # account is named in this tree; a checkout without it runs both here,
    # unchanged.
    #
    # ⚠⚠ AND THE WRAPPER'S OWN VERDICT IS FINAL — THERE IS NO SECOND FALLBACK
    # HERE, and an earlier version of this block had one that did real harm.
    #
    # It read "the wrapper printed no `bx: exit=` line" as "infrastructure went
    # away" and re-ran the pair locally. But that line is absent for EVERY
    # reason the wrapper declines to start: an untracked file it does not carry,
    # a working tree the far side does not match, a floor no machine meets. All
    # of those are the author's to fix, and all of them were being answered by
    # quietly running the heaviest gate in this repository on the workstation
    # instead. Measured 2026-08-20: six consecutive commits took that path while
    # the box sat at load 13-25 with 11GB in swap, and the log said only that
    # the tree differed.
    #
    # THE WRAPPER ALREADY FAILS OPEN BY ITSELF, which is what made the second
    # fallback both redundant and blind: when no build machine is a candidate
    # and this one can hold the work, it runs it here and reports `where=local`.
    # It refuses only when it cannot proceed safely — and a refusal is a
    # verdict, not an outage. Papering over it is how a hook reports "green"
    # about a tree nobody checked.
    lint_and_doc='cargo clippy --workspace --all-targets -- -D warnings && RUSTDOCFLAGS="-D warnings" CARGO_TARGET_DIR=target/doc-gate cargo doc --workspace --no-deps --document-private-items'

    # ⛔⛔⛔⛔⛔ THE RATCHET LANE — register item 784, and the mechanism this hook was missing.
    #
    # Until this line the hook ran clippy, rustfmt and rustdoc and NO TEST AT ALL. So a commit that
    # broke a ratchet in another crate passed, and passed `pre-push` too, and the only thing that
    # ever said so was CI — measured 2026-08-31: `1f81f93` added a `sprag-tui` test function whose
    # NAME ended `held()`, which is the literal needle a `sprag-gate` ratchet scans the workspace
    # for; two commits then stood red on two platforms for two rounds. A person re-running the gate
    # by hand caught it, and a person is not a mechanism.
    #
    # ⚠⚠⚠⚠ WHY A LANE AND NOT THE SUITE, with the numbers that decided it. `cargo test --workspace`
    # is **258.6 s** warm on the build machine (3819 tests) against **22.3 s** for `sprag-gate`
    # alone (measured 2026-08-31, both after `cargo build --workspace --all-targets`). Item 457 is
    # already open against this hook for costing too much per commit, and its remedy and this one
    # pull in opposite directions — so what runs here is the tests whose INPUT IS THE TREE, which
    # are exactly the ones an unrelated crate's commit can turn red.
    #
    # ⚠⚠⚠ THE MEMBERSHIP IS NOT A LIST SOMEBODY MAINTAINS. Every target named here is derived from
    # a property a test HAS — it reads the repository rather than its own crate — and
    # `a_ratchet_that_reads_the_tree_runs_before_the_commit_lands` reads this file against the tree
    # and goes red if a test acquires that property without joining the lane. A hand-kept list is
    # the escape hatch this workspace's rule 6 is about: it grows, and a real one hides under it.
    #
    # ⚠ IT TRAVELS IN THE SAME COMMAND as clippy and the doc gate, so the tree is synced once and
    # `&&` keeps the fail-fast ordering: the cheap compile error is reported before the tests run.
    ratchets='cargo test -p sprag-gate && cargo test -p sprag-rpc --test pins && cargo test -p sprag-tui --test gpu_free && cargo test -p sprag-client --test gpu_free'
    echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings && doc gate && the ratchet lane ..." >&2
    if [ -n "${BX:-}" ] && [ -x "${BX}" ]; then
        "${BX}" --label pre-commit-lint -- bash -c "$lint_and_doc && $ratchets"
    else
        bash -c "$lint_and_doc && $ratchets"
    fi

    # ⚠⚠⚠⚠⚠ RECORD WHICH TREE THESE GATES CLEARED, so `pre-push` need not run them again on the
    # same content — register item 443, raised by the owner asking why a push takes minutes.
    #
    # MEASURED: the rustdoc gate is **250 s** on a change to a crate the workspace depends on (a
    # separate `CARGO_TARGET_DIR` means it re-documents every dependent), and it ran TWICE per
    # change — here, and again at push. Clippy by then is cached at 0.2 s, so the doubling is
    # entirely this one gate. The push half is what this removes; the safety property it must not
    # remove is `pre-push`'s own reason for existing — *whatever an amend or a `--no-verify` slipped
    # past pre-commit* — which is why what is recorded is the TREE and not a flag.
    #
    # ⚠⚠⚠ `git write-tree` IS THE TREE THIS COMMIT WILL CARRY: the index, written as an object.
    # A push whose tip names that exact tree is a push of content these gates read; anything else —
    # an amend, a rebase, a second commit, a `--no-verify`, a stamp this clone cannot read — will
    # not match, and the push runs them.
    #
    # ⚠⚠⚠⚠ AND THE STAMP IS WITHHELD UNLESS THE WORKING TREE IS THE INDEX for everything these
    # gates compile. Clippy and rustdoc read the WORKING TREE, not the index, so an unstaged edit or
    # an untracked module means what they judged is not what the commit carries — and skipping on
    # that basis would publish a tree nothing had ever compiled. Both are checked; either one
    # withholds the stamp, which costs a push its gates and nothing else.
    #
    # ⚠⚠ EVERY QUERY THAT FAILS READS AS *not clean*, spelled as a word rather than left empty: an
    # unreadable index is exactly the case item 404 measured passing as *nothing to check*, one gate
    # over, and here it would hand a push permission to skip on evidence nobody has.
    gate_paths='*.rs *.scxml Cargo.toml Cargo.lock build.rs rust-toolchain.toml'
    # shellcheck disable=SC2086  # intentional word-split of the pathspec list
    unstaged="$(git diff --name-only -- $gate_paths)" || unstaged="unreadable"
    # shellcheck disable=SC2086  # intentional word-split of the pathspec list
    untracked="$(git ls-files --others --exclude-standard -- $gate_paths)" || untracked="unreadable"
    staged_tree="$(git write-tree)" || staged_tree=""
    git_dir="$(git rev-parse --git-dir)" || git_dir=""
    if [ -z "$unstaged" ] && [ -z "$untracked" ] && [ -n "$staged_tree" ] && [ -n "$git_dir" ]; then
        printf '%s\n' "$staged_tree" >"$git_dir/sprag-rust-gates-passed"
    else
        if [ -n "$git_dir" ]; then
            rm -f "$git_dir/sprag-rust-gates-passed"
        fi
        echo "pre-commit: the working tree is not what this commit carries, so the push will run \
clippy, the rustdoc gate and the ratchet lane again" >&2
    fi
fi

# The workflow gate — a workflow file is the one thing CI cannot gate, since an invalid expression
# means the run never STARTS. See `.githooks/content-gate.sh` for that reasoning in full.
#
# ⚠⚠⚠⚠ AND THIS GATE HAD THE RUSTFMT GATE'S DEFECT TOO, found by the sweep that followed fixing it:
# it took the staged NAMES and then handed actionlint the WORKING-TREE bytes, so a broken workflow
# went out whenever the file was tidied after staging. Fixing one copy of a shape and leaving its
# neighbour is register item 213 exactly, which is why both gates now share one mirror.
if [ -n "$staged_workflows" ]; then
    # shellcheck disable=SC2086  # intentional word-split of the file list
    if ! workflow_gate "pre-commit" "" $staged_workflows; then
        echo "pre-commit: the STAGED workflow is invalid — fix it and stage the result" >&2
        exit 1
    fi
fi
