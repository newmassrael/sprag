#!/usr/bin/env bash
# pre-push hook — re-run integrity + lint gates before publishing to a remote.
#
# Push is the natural integrity-gate point: this is where the project's
# audit-traced state becomes shared. Catches state changes since the last
# commit (manual atomic.json edits, amends, rebases, `--no-verify` bypasses)
# that pre-commit may have missed.
#
# Checks:
#   1. `mnemosyne-cli validate-workspace` (unconditional)
#      - T1 cross-ref orphan delta + atomic ledger consistency (store-direct)
#   2. the format gate (`.githooks/content-gate.sh`) over the *.rs files the PUSHED
#      RANGE carries, read from the commit rather than the working tree
#      - ⚠⚠⚠⚠ ADDED 2026-08-17 (item 404), because driving this hook as a
#        program showed the hole: format is the gate `pre-commit` owns ALONE,
#        which makes it the one a `--no-verify` bypass most reliably steps
#        over — and it was the one this second chance did not offer. The list
#        above named the bypass as a reason this hook exists while leaving out
#        the check that bypass defeats.
#      - read from the COMMIT on purpose: what the remote receives is the
#        commit, and a tidy working copy says nothing about it.
#   3. the Rust gates — clippy, the rustdoc gate, the ratchet lane — NOT RUN
#      HERE, and that is register item 480's repair rather than an omission.
#      They are checked by STAMP: a tree `.githooks/rust-gates.sh` has cleared
#      is waved through, and a tree it has not is REFUSED with that command
#      named. `git push` opens its connection before this hook runs, so a gate
#      that outlasts the remote's idle timeout loses the push after passing —
#      measured: 7m15s, SIGPIPE 141, `origin/main` unmoved.
#      - an amend or a `--no-verify` bypass still cannot publish a dead link or
#        a red ratchet: it meets the refusal instead of seven minutes.
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
set -euo pipefail

if ! command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-push: mnemosyne-cli not on PATH — install mnemosyne-cli first" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/doc-gate.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/content-gate.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/ident-gate.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/hosted-read.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/loop-read.sh"
# shellcheck source-path=SCRIPTDIR
. "$repo_root/.githooks/tree-drift.sh"

# ⛔⛔⛔⛔ FINGERPRINT THE TREE BEFORE ANY GATE READS IT — register item 925, and THIS is
# the hook the item was filed against.
#
# Measured 2026-09-06, paying item 843: the ratchet lane went red with `no variant named
# `UnrunnableRed``, because the tree at that instant held a line USING a variant the
# session had not written yet. The hook was right, `origin/main` never moved, and the
# reader had no way to tell that from a defect in the change being pushed.
#
# ⚠ It arms a `trap ... EXIT`, so the report prints on the failing paths too — which are
# the only paths where it matters. The trap preserves this hook's own exit status.
# ⚠⚠ It SAYS; it does not block. Two writers share this tree (item 196), and refusing on
# somebody else's edit would stand their round down for the length of these gates.
tree_drift_begin "pre-push" "$repo_root"

# ── HOW LONG THIS CLONE HAS GONE WITHOUT READING A HOSTED RESULT ─────────────
#
# ⛔⛔⛔⛔⛔ REGISTER ITEM 776, arms (1), (2) and (4). A REPORT AND NOT A GATE,
# said here so nobody wires it to an exit status later by reflex.
#
# The push in this repository is pre-authorised and `CLAUDE.md` says push and
# continue, reading the previous run at the start of the next round. That rule
# was in force while CI carried 33 consecutive reds over two days. What was
# missing is not a rule: it is that a round which never looked and a round which
# looked and saw green render IDENTICALLY. So the number is said at the one
# moment it is certainly being decided -- publishing -- and refusing is left
# alone, because "push and continue" is this repository's deliberate choice and
# a hook that overturned it would be answering a question nobody asked here.
#
# ⚠ Its arithmetic is gated where arithmetic can be: `hosted-read.sh
# --selftest`, and `sprag-gate` drives this hook and reads for this line.
hosted_read_gap

# ── WHETHER A RUN OF THIS REPOSITORY'S OWN LOOP ENDED WITH NOBODY WATCHING ────
#
# ⛔⛔⛔⛔⛔ REGISTER ITEM 798, and the same shape as the line above rather than a
# second kind of thing: a REPORT, not a gate. The line above asks GitHub about a
# commit; this one reads the daemon's own run log off disk.
#
# What it is for, in this repository's own number: five runs ended on 2026-09-01
# and a person had to re-launch every one, and the last of them was `failed` for
# over an hour before the watcher knew -- because the ending is on a screen and a
# screen only reaches somebody looking at it. The north star is a loop that runs
# WITHOUT a watcher, so the ending has to leave the screen. It leaves it here.
#
# ⛔ IT DOES NOT RE-LAUNCH AND DOES NOT SAY WHICH FAILURES ARE RETRYABLE. Item
# 798 is explicit that telling those apart comes first and that what it asks for
# is REACH. Wiring this to an exit status, or to a restart, would be answering a
# question nobody has asked yet.
#
# ⚠ Its arithmetic is gated where arithmetic can be: `loop-read.sh --selftest`,
# which `crates/sprag-gate/` runs without anybody adding it to a list (item 799).
loop_read_gap

# ⚠⚠⚠⚠ THE REFS ARE READ ONCE, HERE, BEFORE ANYTHING ELSE RUNS.
#
# Git feeds the refs being pushed on STDIN, and stdin is a ONE-SHOT stream: two consumers cannot
# both read it. This hook now has two — the pixel-smoke decision and the format gate — so the
# stream is drained into a variable at the top and both walk that.
#
# It also closes a fragility the single consumer had: every tool this hook shells out to inherits
# stdin, so a `mnemosyne-cli` or a `cargo` that read even PART of it would have silently eaten the
# refs, and a partly-eaten list means a paint change going unlooked-at. Measured 2026-08-17:
# today's `mnemosyne-cli` leaves stdin alone. That is a fact about today's tool, not a property of
# the design — reading first makes it one.
pushed_refs="$(cat)"

# ── The identities this push would publish. FIRST among the gates, because it
# is the only failure here that a revert does not undo: the remote is public
# and a push does not un-publish.
#
# WHY THE PUSH AND NOT ONLY THE COMMIT. `pre-commit` carries the same list and
# would not have caught the incident ident-gate.sh describes: those commits
# were made where the hooks were not installed, so the push is the first moment
# this repository can see them and the last before they are published. It is
# also the argument for reading the range rather than `git var` here — what
# matters is what the RANGE carries, not what this machine would stamp next.
#
# Walks `pushed_refs` like every other gate below, for the stdin reason the
# block above states at length.
ident_push_failed=0
while read -r _iref ilocal _irref iremote; do
    [ -n "${ilocal:-}" ] || continue
    case "$ilocal" in
        *[!0]*) ;;
        *) continue ;;   # a deletion carries no commits to judge
    esac
    case "${iremote:-}" in
        # A new ref on the remote grades the WHOLE history — deliberate, not
        # incidental: that is exactly when a stray identity would be published
        # wholesale.
        ""|*[!0]*) ident_range="${iremote:-}..${ilocal}" ;;
        *) ident_range="$ilocal" ;;
    esac
    [ -n "${iremote:-}" ] || ident_range="$ilocal"
    ident_gate_range "pre-push" "$ident_range" || ident_push_failed=1
done <<EOF
$pushed_refs
EOF
if [ "$ident_push_failed" -ne 0 ]; then
    echo "pre-push: rewrite the offending commits before pushing — the remote is public" >&2
    echo "pre-push: and a push does not un-publish" >&2
    exit 1
fi

# ── The pixel smoke, when this push touches what it paints.
#
# WHY THIS IS HERE AT ALL. The smoke is the only gate that looks at PIXELS, and it ran in neither CI
# nor pre-commit. So its number was only ever as current as the last round that felt like running it
# — and R349 shipped a paint change without it, leaving it RED for eleven rounds while every other
# gate stayed green. A gate nobody runs goes red in silence, and the number people quote for it is a
# date rather than a state.
#
# ⚠⚠⚠⚠⚠ AND THAT IS NO LONGER THE WHOLE PICTURE: CI runs this same binary on EVERY push, in the
# `pixel (linux)` job, under xvfb with the same GPU-less Vulkan. It grew after the paragraph above
# was written and the paragraph did not follow. What this list scopes is therefore LOCAL FEEDBACK —
# whether a paint break is caught before publishing or one round later — and NOT whether the smoke
# runs at all. Reading it as coverage is what registers 608 and 611 both did in one round, one of
# them concluding the shipped topology passed through no gate while `pixel (linux)` was green on the
# very commit. `a_hook_that_scopes_a_gate_is_read_against_where_that_gate_runs` holds these two
# artefacts together so the next rename cannot quietly separate them again.
#
# WHY IT IS SCOPED. It is minutes, not seconds. It runs when the push carries a change to what it
# watches — the GUI client and the re-wrap the client paints through — and not otherwise. ⚠ The
# residue that leaves, stated: a change to `crates/sprag-client` (the shipped GUI's own `WireHost`)
# or to the daemon paints differently and does NOT run this locally. CI still catches it; the cost
# is a round of latency, which is the trade this repository already makes everywhere else.
#
# WHY IT REFUSES INSTEAD OF SKIPPING. A gate that quietly steps aside on the machine that lacks its
# tools is the state this exists to end: it would be absent exactly where nobody notices. Missing
# tools are a failed push with the package named. The deliberate bypass is `--no-verify`, which is
# loud and already how everything else here is escaped.
PIXEL_PATHS="crates/sprag-gui crates/sprag-grid"

# ── What a change to a HOOK owes, and why it is this hook's business — register item 688.
#
# ⛔⛔⛔⛔⛔ A ROUND ADDED `ident-gate.sh` TO THE TWO HOOKS AND KILLED SEVENTEEN TESTS ONE CRATE OVER,
# AND TWENTY-ONE CONSECUTIVE PUSHES CARRIED THE RED BEFORE ANYBODY READ CI. `sprag-gate` links the
# real hooks into a throwaway repository and drives them (its own doc: linked, not copied, register
# item 467), so it is the ONLY crate a hook change can break -- and the only crate this gate did not
# run. Everything below it ran: validate-workspace, clippy, rustdoc, the pixel smoke. The one thing
# that reads what was actually edited did not.
#
# ⚠⚠ IT IS THE SAME SHAPE AS `PIXEL_PATHS` ON PURPOSE. A push that changes what the GUI paints owes
# a look at pixels; a push that changes a hook owes a run of the suite that drives hooks. Two paths,
# one rule, one ref walk.
HOOK_PATHS=".githooks"

# Does the pushed range carry a change under the pathspecs given?
#
# Walks the refs read above. Anything it cannot resolve into a comparison — a brand-new remote
# branch, a remote commit this clone does not have, an empty stdin from a manual invocation —
# answers YES: the failure this guards is a change going unlooked-at, so the unknown case
# runs the gate rather than waiving it.
#
# ⚠⚠⚠ ONE WALK, TWO CALLERS — register item 213, and item 688 is why there are two. The ref walk is
# the fiddly part (the deletion case, the unresolvable sha, the here-string's blank line) and a
# second function shaped exactly like it is the duplication that item is about. What differs
# between a paint gate and a hook gate is a list of paths, so a list of paths is the argument.
pushed_range_touches() {
    local owed=1 saw_ref=1 local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        # ⚠ A here-string always yields one line, so an EMPTY ref list arrives as a blank one.
        # Counting that as a ref seen would turn "I was told nothing" into "nothing changed",
        # which inverts the stance stated just above.
        [ -n "$local_sha" ] || continue
        saw_ref=0
        : "$local_ref" "$remote_ref"
        # A deletion pushes an all-zero local sha and carries no tree to look at.
        case "$local_sha" in
            *[!0]*) ;;
            *) continue ;;
        esac
        # ⚠⚠⚠ THE LOCAL SIDE IS CHECKED TOO, AND IT WAS NOT BEFORE. `set -e` is suppressed inside a
        # function used as an `if` condition (see the note on the format walker below), so a
        # `git diff` against an unresolvable local sha answered EMPTY rather than aborting — and
        # empty reads as "nothing painted", waiving the smoke. That is the precise opposite of the
        # stance stated above, arrived at by the failure mode the stance exists to prevent.
        if ! git cat-file -e "${local_sha}^{commit}" 2>/dev/null ||
            ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
            owed=0
            continue
        fi
        if [ -n "$(git diff --name-only "$remote_sha" "$local_sha" -- "$@")" ]; then
            owed=0
        fi
    done <<<"$pushed_refs"
    [ "$saw_ref" -eq 0 ] || owed=0
    return "$owed"
}

# ⚠ The two callers, so the pathspec lists stay named where they are declared rather than being
# spelled at the call sites — the same reason `PIXEL_PATHS` was a constant to begin with.
# shellcheck disable=SC2086  # both lists are deliberate word-split pathspecs
pixel_smoke_is_owed() { pushed_range_touches $PIXEL_PATHS; }
# shellcheck disable=SC2086  # both lists are deliberate word-split pathspecs
hook_suite_is_owed() { pushed_range_touches $HOOK_PATHS; }

# ── The suite that DRIVES these hooks, run when this push changes one — register item 688.
#
# ⚠⚠⚠ IT REFUSES RATHER THAN SKIPS WHERE CARGO IS MISSING, `run_pixel_smoke`'s stance verbatim: a
# gate that quietly steps aside on the machine that lacks its tools is absent exactly where nobody
# notices. This one is cheap — the suite it runs finished in under a second on both CI platforms —
# so there is no latency argument for waiving it either.
run_hook_suite() {
    echo "pre-push: this push changes a hook — cargo test -p sprag-gate ..." >&2
    if ! cargo test -p sprag-gate; then
        echo "pre-push: the hook suite failed — a hook that breaks the crate that drives it must \
not be published; register item 688 is what this gate exists for" >&2
        return 1
    fi
}

# ── The content gates over what this push actually publishes.
#
# Walks the same refs for the same reason and with the same stance: where there is nothing to
# compare against, judge the whole tree rather than waive it. A brand-new branch is otherwise the
# one push that is never checked, which is precisely the push most likely to carry work no gate has
# seen.
#
# ⚠⚠⚠ BOTH GATES SHARE ONE WALK. The alternative — a second function shaped exactly like this one —
# is the duplication register item 213 is about, and the ref walk is the fiddly part: the deletion
# case, the unresolvable sha, the here-string's blank line. One traversal, two checkers.
#
# ⚠⚠⚠⚠ AND THE WORKFLOW GATE BELONGS HERE MORE THAN THE FORMAT ONE DOES. This hook's header names
# the `--no-verify` bypass as a reason it exists, and a workflow is THE ONE THING CI CANNOT CATCH
# AFTERWARDS: an invalid expression does not fail a step, the run never STARTS, so there is no job
# and no log. The round that added the format gate here left this out and recorded a reason that did
# not survive rereading — the header's promise covers whatever pre-commit missed, workflows included.
#
# ⚠⚠⚠⚠ EVERY FAILURE IN HERE IS HANDLED BY HAND, BECAUSE `set -e` IS NOT IN FORCE.
#
# A function invoked as the condition of an `if` runs with errexit SUPPRESSED — throughout its whole
# body, not just at the top. Measured: `f() { false; echo REACHED; }; if ! f; then …` prints
# REACHED. So inside this function a failing `git` does NOT abort the hook; it leaves its output
# variable empty, `[ -n "$paths" ]` reads false, and the range is skipped. A gate that answers
# "nothing to judge" because its query ERRORED is the exact silent pass this whole item is about, so
# each git call below is tested rather than trusted.
content_gates_over_pushed_range() {
    local status=0 local_ref local_sha remote_ref remote_sha changed rust workflows
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "$local_sha" ] || continue
        : "$local_ref" "$remote_ref"
        # A deletion pushes an all-zero local sha and carries no tree to judge.
        case "$local_sha" in
            *[!0]*) ;;
            *) continue ;;
        esac
        if ! git cat-file -e "${local_sha}^{commit}" 2>/dev/null; then
            echo "pre-push: $local_ref is $local_sha, which this clone cannot resolve — a gate" >&2
            echo "pre-push: cannot judge what it cannot read, so this push is refused" >&2
            status=1
            continue
        fi
        if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
            if ! changed="$(git diff --name-only --diff-filter=ACMR "$remote_sha" "$local_sha")"; then
                echo "pre-push: could not read the range $remote_sha..$local_sha" >&2
                status=1
                continue
            fi
        else
            if ! changed="$(git ls-tree -r --name-only "$local_sha")"; then
                echo "pre-push: could not list the tree at $local_sha" >&2
                status=1
                continue
            fi
        fi

        # ⚠ Filtered HERE rather than by a git pathspec, and that is measured, not stylistic:
        # `git ls-tree` takes no glob pathspec and fails QUIETLY when handed one — `-- '*.rs'`
        # matched zero files and exited 0, which reads as "this push carries no Rust". Filtering
        # the listing keeps both branches answering the same question the same way.
        rust="$(printf '%s\n' "$changed" | grep -E '\.rs$' || true)"
        workflows="$(printf '%s\n' "$changed" | grep -E '^\.github/workflows/.*\.ya?ml$' || true)"

        if [ -n "$rust" ]; then
            # shellcheck disable=SC2086  # intentional word-split of the file list
            fmt_gate "pre-push" "$local_sha" $rust || status=1
        fi
        if [ -n "$workflows" ]; then
            # shellcheck disable=SC2086  # intentional word-split of the file list
            workflow_gate "pre-push" "$local_sha" $workflows || status=1
        fi
    done <<<"$pushed_refs"
    return "$status"
}

# Build the whole set in ONE release invocation and run the smoke under a fresh, isolated home.
#
# One invocation because the binaries must agree: the smoke drives a daemon and a terminal client
# beside the GUI, and a set built piecemeal has bitten this project before (a stale daemon binary
# cost four cycles). A fresh XDG home because the smoke writes user config, and a run that read the
# developer's would be asserting about their machine.
run_pixel_smoke() {
    if ! command -v xvfb-run >/dev/null 2>&1; then
        echo "pre-push: the pixel smoke needs xvfb-run — install xvfb" >&2
        return 1
    fi
    if ! ls /usr/share/vulkan/icd.d/lvp_icd*.json >/dev/null 2>&1; then
        echo "pre-push: the pixel smoke needs the lavapipe Vulkan ICD — install mesa-vulkan-drivers" >&2
        return 1
    fi

    echo "pre-push: this push paints — cargo build --release (gui, host, tui) ..." >&2
    if ! cargo build --release -p sprag-gui -p sprag-host -p sprag-tui; then
        echo "pre-push: the smoke set did not build" >&2
        return 1
    fi

    local home
    # ⛔⛔⛔ THE SCRATCH IS CHECKED WHERE IT IS TAKEN — register item 792. An
    # unchecked `mktemp` (127 when it is off PATH) leaves this empty, and the
    # next line becomes `mkdir -p /config /data /state` with the smoke then
    # pointed at them by `XDG_*`.
    home="$(mktemp -d)" || return 1
    mkdir -p "$home/config" "$home/data" "$home/state"
    echo "pre-push: pixel smoke ..." >&2
    if ! XDG_CONFIG_HOME="$home/config" XDG_DATA_HOME="$home/data" XDG_STATE_HOME="$home/state" \
        xvfb-run -a ./target/release/sprag-smoke; then
        rm -rf "$home"
        echo "pre-push: the pixel smoke failed — the checks it prints are the diagnosis" >&2
        return 1
    fi
    rm -rf "$home"
    return 0
}

# ── Were clippy and the rustdoc gate already run, by `pre-commit`, on exactly what this push
# publishes?
#
# ⚠⚠⚠⚠⚠ WHY THIS EXISTS: the rustdoc gate is **250 s** on a change to a crate the workspace depends
# on, and it ran twice per change — at commit and again here (register item 443, raised by the owner
# asking why a push takes minutes). Clippy by then is cached at 0.2 s, so the doubling is one gate.
#
# ⚠⚠⚠ WHAT IT MUST NOT GIVE UP is this hook's whole reason for existing: *whatever an amend or a
# `--no-verify` slipped past pre-commit*. So the question asked is not "did a gate run recently" but
# **"was THIS TREE the one it cleared"** — `pre-commit` writes the index's tree hash after both gates
# pass, and only when the working tree it compiled IS that index. Anything else fails to match: an
# amend, a rebase, a second commit, a commit made with `--no-verify`, a stamp this clone cannot read.
#
# ⚠⚠⚠⚠ EVERY UNKNOWN ANSWERS NO, which is the direction that costs minutes rather than correctness —
# the same stance the pixel walk above takes, inverted because the risk here is skipping rather than
# running. A ref this clone cannot resolve, an empty stdin, a deletion-only push, a missing stamp:
# all of them run the gates. ⚠ And EVERY pushed tip must match, not one of them: a push carrying two
# branches has two trees, and only the last commit made here can have been stamped.
rust_gates_cleared_every_pushed_tip() {
    local stamp cleared saw_ref=0 local_ref local_sha remote_ref remote_sha tip_tree git_dir
    git_dir="$(git rev-parse --git-dir)" || return 1
    stamp="$git_dir/sprag-rust-gates-passed"
    [ -f "$stamp" ] || return 1
    cleared="$(cat "$stamp")" || return 1
    [ -n "$cleared" ] || return 1
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "$local_sha" ] || continue
        : "$local_ref" "$remote_ref" "$remote_sha"
        # A deletion pushes an all-zero sha and carries no tree — nothing to compile, and nothing
        # this stamp can be about either.
        case "$local_sha" in
            *[!0]*) ;;
            *) return 1 ;;
        esac
        saw_ref=1
        tip_tree="$(git rev-parse --verify --quiet "${local_sha}^{tree}")" || return 1
        [ "$tip_tree" = "$cleared" ] || return 1
    done <<<"$pushed_refs"
    [ "$saw_ref" -eq 1 ]
}

# ── Does this push change anything those two gates compile at all?
#
# ⚠⚠⚠⚠ THE SECOND HALF OF ITEM 443, AND THE CASE THAT PAID 192 SECONDS TO LEARN NOTHING: a push of
# documentation, a ledger, or these hooks carries no Rust, so clippy and rustdoc read exactly the
# content the remote already has — and the stamp above cannot help, because a commit that stages no
# `.rs` never runs the gates and so never writes one.
#
# ⚠⚠⚠ THE ARGUMENT IS INDUCTIVE AND IS STATED RATHER THAN ASSUMED: what is published here is
# byte-identical, in every path these gates read, to what was published before it — and that was
# gated by this hook when it went. The induction rests on this hook being the thing that enforces
# it, which is why the unknown cases below refuse to skip.
#
# ⚠⚠ EVERY UNKNOWN ANSWERS *IT DOES CARRY RUST*: a brand-new branch with no remote counterpart, a
# remote sha this clone cannot resolve, a git that fails, an empty stdin. The pixel walk above takes
# the same stance for the same reason — the failure being guarded against is a change going
# unlooked-at, so what cannot be compared is not waived.
RUST_GATE_PATHS='*.rs *.scxml Cargo.toml Cargo.lock build.rs rust-toolchain.toml'

# ── Does this push carry any tree at all?
#
# ⛔⛔⛔⛔⛔ **A DELETION HAS NOTHING TO COMPILE, AND SINCE ITEM 480 THAT MATTERS** — measured
# 2026-09-10 by this repository's own hook suite, on the round that wrote the refusal below.
#
# While the branch below RAN the gates, a push nothing could be said about was answered
# conservatively: run them anyway. That was free, because running a gate over a tree that is not
# being published wastes time and refuses nothing. **A refusal is not free.** `git push --delete`
# publishes no content — its local sha is all zeros and there is no tip to stamp — so refusing it
# means a stale branch can never be removed, which is the sandbox's own words for it.
#
# ⚠⚠ IT IS NARROWER THAN *there is nothing to compare against*. A push whose refs this hook could
# not read at all still reaches the refusal, deliberately: that is the case where something IS being
# published and nobody knows what, and item 480's repair must not turn the conservative answer into
# a waiver. Only a ref that carries no tree by construction is waved through here.
pushed_range_compiles_nothing() {
    local saw_ref=0 saw_tree=0 local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "$local_sha" ] || continue
        : "$local_ref" "$remote_ref" "$remote_sha"
        saw_ref=1
        case "$local_sha" in
            *[!0]*) saw_tree=1 ;;
            *) ;;
        esac
    done <<<"$pushed_refs"
    [ "$saw_ref" -eq 1 ] && [ "$saw_tree" -eq 0 ]
}

pushed_range_carries_no_rust() {
    local saw_ref=0 local_ref local_sha remote_ref remote_sha changed
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "$local_sha" ] || continue
        : "$local_ref" "$remote_ref"
        case "$local_sha" in
            *[!0]*) ;;
            *) continue ;;
        esac
        saw_ref=1
        if ! git cat-file -e "${local_sha}^{commit}" 2>/dev/null ||
            ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
            return 1
        fi
        # shellcheck disable=SC2086  # intentional word-split of the pathspec list
        changed="$(git diff --name-only "$remote_sha" "$local_sha" -- $RUST_GATE_PATHS)" || return 1
        [ -z "$changed" ] || return 1
    done <<<"$pushed_refs"
    [ "$saw_ref" -eq 1 ]
}

echo "pre-push: mnemosyne-cli validate-workspace ..." >&2
if ! mnemosyne-cli validate-workspace; then
    echo "pre-push: validate-workspace failed — fix violations before push" >&2
    exit 1
fi

# The citation gate — a DIFFERENT command from the one above, which checks only
# scan coverage and not the citations (see the pre-commit note). Re-run here for
# the reason clippy is: an amend or a `--no-verify` bypass can put a dead `§`
# reference into the history that pre-commit never saw.
#
# ⚠⚠ THE TOOL'S OWN REPORT IS KEPT AND SHOWN — register item 213. Discarded, this told a person
# *"fix the dead citation"* without saying WHICH, so the one thing they need was in `/dev/null`.
echo "pre-push: mnemosyne-cli validate-code-refs ..." >&2
if ! refs_report="$(mnemosyne-cli validate-code-refs 2>&1)"; then
    printf 'pre-push: validate-code-refs failed — fix the dead citation before push:\n%s\n' \
        "$refs_report" >&2
    exit 1
fi
# ⚠⚠⚠⚠ AND THE FILTER CANNOT SWALLOW THE MISS — the same line, and the same reasoning, as in
# `pre-commit`. Pinning item 213's fix to the word `violations:` in a tool this repository pins no
# version of means a rename puts fifty-two findings back in /dev/null silently. Kept in step with
# its sibling deliberately: the two copies drifting apart for twelve commits is what item 213 WAS.
if ! printf '%s\n' "$refs_report" | grep -E '^violations:' >&2; then
    printf 'pre-push: validate-code-refs printed no "violations:" summary; its report in full:\n%s\n' \
        "$refs_report" >&2
fi

# The content gates, before the expensive ones: they are milliseconds, and a push that is going to
# be refused should be refused before clippy spends minutes agreeing with it.
if ! content_gates_over_pushed_range; then
    echo "pre-push: the content this push publishes was refused — fix it, commit, and push again" >&2
    exit 1
fi

if [ -f Cargo.toml ]; then
    # ⚠⚠⚠⚠ `-D warnings`, WHICH THIS HOOK WAS MISSING WHILE ITS SIBLING WAS FIXED — register item
    # 213, found by the audit that item asks for. `pre-commit` gained the flag in `949dd73` after
    # three lints rode through several commits; **this line never did**, so the push gate went on
    # printing findings and exiting 0 for everything an amend or a `--no-verify` slipped past
    # pre-commit — which is precisely the hole this second run exists to close.
    if rust_gates_cleared_every_pushed_tip; then
        echo "pre-push: clippy, the rustdoc gate and the ratchet lane already passed on this exact \
tree — skipping" >&2
    elif pushed_range_compiles_nothing; then
        echo "pre-push: this push carries no tree to compile — nothing for these gates to be \
about" >&2
    elif pushed_range_carries_no_rust; then
        echo "pre-push: this push changes nothing clippy or rustdoc reads — skipping both" >&2
    else
        # ⛔⛔⛔⛔⛔ **REFUSED HERE RATHER THAN RUN HERE** — register item 480, and the whole of its
        # remaining half.
        #
        # `git push` OPENS THE CONNECTION FIRST and runs this hook after it, so every second spent
        # below is spent on an open ssh session. Measured 2026-08-20 while paying item 456: the
        # rustdoc gate took **7m15s**, GitHub answered *"Connection to github.com closed by remote
        # host"*, and `git push` exited **141 (SIGPIPE) after every gate had PASSED** —
        # `git ls-remote origin main` confirmed the ref had not moved. A green gate lost the push,
        # and the retry succeeded in seconds against a warm `target/doc-gate`, which is exactly why
        # this reads as a flake and is not one: it is a race between one command's runtime and a
        # remote's idle timeout, decided by cache temperature.
        #
        # ⚠⚠⚠ **A RETRY LOOP IS NOT THE FIX** — the item says so in as many words, because a retry
        # hides which of the three things happened. Neither is offloading to `bx`: the work would
        # move to another machine and the WALL CLOCK inside the connection would not change at all.
        # What actually stops the connection being spent is not spending it.
        #
        # ⚠⚠ **AND THE REFUSAL NAMES A COMMAND, which is what stops it being a wall.** The stamp
        # above is written by `pre-commit`, and after a commit there is no `.rs` staged, so nothing
        # a person could type would clear this. `.githooks/rust-gates.sh` runs the same lane
        # `pre-commit` runs — one copy of it, register item 213 — and stamps the tree, outside any
        # connection.
        #
        # ⚠ **WHAT THIS DOES NOT GIVE UP**: item 784's property, that a push is the last place a
        # red can be stopped before CI is the one to say so. It is still stopped here — by refusal
        # rather than by seven minutes — and the refusal SPELLS THE LANE, which is both what a
        # person needs and what that item's own reader walks this file for.
        echo "pre-push: REFUSED — this push would spend an open GitHub connection on gates that \
compile the workspace, and a gate that outlasts the remote's idle timeout loses the push after \
passing (register item 480: 7m15s, SIGPIPE 141, the ref unmoved)." >&2
        # ⚠⚠ THE INDIVIDUAL COMMANDS ARE NOT SPELLED HERE, and that is deliberate rather than terse:
        # `no_push_hook_spends_the_connection_on_a_gate` asks that this file not carry them at all,
        # because a reader deciding *does this hook run clippy* would otherwise have to read shell
        # quoting to tell an `echo` from a call — the ambiguity
        # `a_fleet_ceiling_is_a_measurement_with_a_date` had to solve with a command-position rule.
        # The remedy is ONE command, and the lane below is spelled because item 784's reader walks
        # this file for exactly those targets.
        echo "pre-push: the tree being pushed has been through neither the workspace lint and \
rustdoc gates nor the ratchet lane:" >&2
        echo "pre-push:     cargo test -p sprag-gate && cargo test -p sprag-rpc --test pins && cargo test -p sprag-tui --test gpu_free && cargo test -p sprag-client --test gpu_free" >&2
        echo "pre-push: run them outside the connection and push again:" >&2
        echo "pre-push:     bash .githooks/rust-gates.sh --clear" >&2
        exit 1
    fi

    # ⚠⚠ BEFORE THE PIXEL SMOKE, which builds three crates in release. This one is seconds, and a
    # push that is going to be refused should be refused before the expensive gate agrees with it —
    # the ordering argument the content gates above are already built on.
    if hook_suite_is_owed; then
        run_hook_suite || exit 1
    fi

    if pixel_smoke_is_owed; then
        run_pixel_smoke || exit 1
    fi
fi

exit 0
