<?xml version="1.0" encoding="UTF-8"?>
<!--
  sprag orchestration control statechart (Round 8).

  A pure-control perceive -> act -> judge loop with guardrail branching. Like
  pinion's widget statecharts it is datamodel="null": no datamodel, no side
  effects, just states / transitions. The Rust driving loop (sprag-orchestrator)
  is the effect executor - it reads this machine's current state, performs the
  I/O (inject a stimulus into a pane, observe its screen), evaluates the
  guardrails (iteration / cost counters live in the loop), and feeds back the
  next event. Termination is expressed as three distinct <final> states.

  Adding future control (a depth/recursion gate, cost-routing, a human-approval
  pause) is a statechart edit here, not driving-loop spaghetti.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null"
       initial="idle">

  <!-- Waiting to be started. -->
  <state id="idle">
    <transition event="start" target="stimulating"/>
  </state>

  <!-- Act: the loop injects the stimulus into the pane. -->
  <state id="stimulating">
    <transition event="stimulated" target="observing"/>
    <transition event="fail" target="failed"/>
  </state>

  <!-- Perceive: the loop reads the pane's output. -->
  <state id="observing">
    <transition event="observed" target="judging"/>
    <transition event="fail" target="failed"/>
  </state>

  <!-- Judge: the loop checks convergence + guardrails and routes. -->
  <state id="judging">
    <transition event="iterate" target="stimulating"/>
    <transition event="converge" target="converged"/>
    <transition event="exhaust" target="exhausted"/>
  </state>

  <!-- Terminal outcomes. -->
  <final id="converged"/>
  <final id="exhausted"/>
  <final id="failed"/>
</scxml>
