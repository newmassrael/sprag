#!/bin/sh
# A `sed` THAT REFUSES THE GNU EXTENSIONS -- the double that lets a Linux runner
# measure what BSD `sed` does, for register items 798 and 799.
#
# ⛔ WHY IT IS TRACKED RATHER THAN WRITTEN. Register item 467: a file a process
# holds open for writing cannot be executed, and this workspace's harness forks
# from threads. A suite that manufactures its own program meets ETXTBSY sooner or
# later and the failure reads as a flake. So this is a file the repository
# carries, reached through `sprag_gate::doubles`.
#
# ⚠ The real `sed` arrives by name in the environment rather than being searched
# for: this double sits AT THE FRONT of `PATH`, so `command -v sed` here would
# find this script and exec itself forever.
#
# ⛔⛔⛔⛔⛔ AND `--posix` IS ONLY HALF OF THE DIFFERENCE -- register item 1001.
#
# `--posix` turns off GNU's REGULAR EXPRESSION extensions, which is the whole of
# the `\|` reading items 798 and 799 were about. It does not change how a script
# is PARSED INTO COMMANDS, and that is the second place the two seds disagree:
# the argument of a label or a branch ends at a NEWLINE, so BSD sed reads
# `:a` followed by `; s/A A/A/; ta` as ONE label whose NAME is all of it, warns
# `unused label`, EXITS 0, and silently never runs the loop. GNU reads the `;`
# as a command separator and does.
#
# ⚠⚠ MEASURED 2026-09-10, and the measurement is why this arm exists: with a
# FreeBSD sed built from source on the Linux box, `.githooks/loop-read.sh`'s
# normaliser collapsed its keys under GNU and did NOT under BSD -- while THIS
# DOUBLE, run exactly as the suite runs it, collapsed them too. So the
# environment the suite calls *a POSIX sed* was not a measurement of this at
# all, and the spelling rode into the macOS job for two rounds with every Linux
# run green.
#
# ⇒ A REFUSAL rather than an emulation, stated plainly: GNU sed has no flag that
# makes it read a label BSD's way, so a double that cannot reproduce the
# difference must refuse the spelling instead of passing it.
#
# ⚠ WHAT THIS SCAN CAN AND CANNOT SEE. It splits a script on `;` and asks
# whether a fragment that is not the last one begins with a label or a branch.
# So a `;` inside a regular expression can start a fragment that only LOOKS like
# a branch (`s/;t1;/x/`), and `-f script-file`, a bundled `-ne`, and a script
# arriving on standard input are not read at all. Those are stated rather than
# implied; every script this repository's hooks actually spell is an argument.

# Refuse the script in $1 because of the label rule, naming what to do about it.
say_unportable() {
    printf '%s\n' \
        "sed (the POSIX double): REFUSING a script BSD sed reads differently:" \
        "  $1" \
        "  The argument of a ':' label and of a 'b'/'t' branch ends at a NEWLINE," \
        "  not at a ';'. BSD sed therefore reads everything after the label as part" \
        "  of its NAME, prints 'unused label', exits 0, and runs none of it -- so" \
        "  this script means something different there and says nothing about it." \
        "  Give each label and branch its own -e fragment, or write the script with" \
        "  no loop at all. Register item 1001." >&2
    exit 2
}

# ⛔⛔⛔⛔⛔ THE SECOND RULE IS NOT SPELLED HERE -- register item 1007. `\|`, `\+`
# and `\?` are GNU extensions to a BASIC regular expression, and that is one fact
# about `regcomp` rather than a fact about sed: the `grep` beside this file hands
# the same text to the same library. So the rule lives ONCE, in `bre-rule.sh`,
# and both stand-ins source it. A copy in each is the drift this workspace keeps
# paying for -- and it would drift in the direction that matters, because only
# one of the two copies would be the one a hook actually meets.
bre_program="sed (the POSIX double)"
bre_remedy="Write the POSIX spelling: \\| as a bracket or two s commands, \\+ as
  X[X]* (X twice), and \\? as \\(X\\)\\{0,1\\}."

sed_here="${0%/*}"
[ "$sed_here" != "$0" ] || sed_here=.
[ -f "$sed_here/bre-rule.sh" ] || {
    printf '%s\n' \
        "sed (the POSIX double): the shared rule is not beside me." \
        "  looked in: $sed_here/bre-rule.sh (from \$0=$0)" \
        "  This stand-in enforces nothing without it, and passing quietly is the" \
        "  one thing it must never do. Register item 1007." >&2
    exit 2
}
. "$sed_here/bre-rule.sh"

# Refuse $1 when a label or branch is followed by more script on the same line.
scan_script() {
    scan_rest="$1"
    while [ "$scan_rest" != "${scan_rest#*;}" ]; do
        scan_head="${scan_rest%%;*}"
        scan_rest="${scan_rest#*;}"
        while [ "$scan_head" != "${scan_head# }" ]; do
            scan_head="${scan_head# }"
        done
        while [ "$scan_head" != "${scan_head#	}" ]; do
            scan_head="${scan_head#	}"
        done
        case "$scan_head" in
            :[0-9A-Za-z_-]* | b[0-9A-Za-z_-]* | t[0-9A-Za-z_-]*) say_unportable "$1" ;;
        esac
    done
    # ⚠ The shared rule reads `bre_extended` for itself; the flag is set below off
    # argv rather than assumed.
    bre_scan "$1"
}

# ⚠ TWO PASSES, because `-E` may be spelled AFTER the script it governs and a
# one-pass scan would judge that script under the wrong grammar.
bre_extended=0
for sed_arg in "$@"; do
    case "$sed_arg" in
        -E | -r | --regexp-extended) bre_extended=1 ;;
    esac
done

# Which arguments are SCRIPTS: every `-e` value, or the first non-option when no
# `-e` and no `-f` was given. Everything else is an option or an input file.
sed_expect=""
sed_seen_script=0
for sed_arg in "$@"; do
    if [ "$sed_expect" = script ]; then
        scan_script "$sed_arg"
        sed_expect=""
        continue
    fi
    if [ "$sed_expect" = file ]; then
        sed_expect=""
        continue
    fi
    case "$sed_arg" in
        -e | --expression)
            sed_expect=script
            sed_seen_script=1
            ;;
        --expression=*)
            scan_script "${sed_arg#--expression=}"
            sed_seen_script=1
            ;;
        -e*)
            scan_script "${sed_arg#-e}"
            sed_seen_script=1
            ;;
        -f | --file)
            sed_expect=file
            sed_seen_script=1
            ;;
        -*) ;;
        *)
            if [ "$sed_seen_script" -eq 0 ]; then
                scan_script "$sed_arg"
                sed_seen_script=1
            fi
            ;;
    esac
done

# ⛔⛔⛔⛔⛔ SCAN-ONLY, so the RULE ABOVE HAS EXACTLY ONE IMPLEMENTATION --
# register item 1006. The strict sed only ever met the scripts a DECLARED
# selftest happens to run, and six of this repository's hook scripts declare
# none, so their sed lines were judged by nothing at all. The gate that closes
# that walks the tree, hands each command's argv here, and reads this status --
# which means the population is FILES and the rule is still this file. A second
# copy of *what is unportable*, written in Rust, is the drift this workspace
# keeps paying for.
#
# ⚠ It exits before `exec` on purpose: the caller wants the VERDICT, not the
# edit. A script lifted out of source text still carries `${variables}`, and
# running it would refuse for reasons that have nothing to do with portability.
if [ "${SPRAG_SED_SCAN_ONLY:-0}" = 1 ]; then
    exit 0
fi

exec "${SPRAG_REAL_SED:?the real sed must be named in SPRAG_REAL_SED}" --posix "$@"
